# Meta Model API (dev.meta.ai)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# fake = scripted fakes, no network. live = real Meta API. record/cassette = record or replay real responses.
META_MODE=fake

# Meta open weights (Muse Spark Open) via Baseten: rung 2 of the heal ladder. The tag is the one GET /v1/models on Baseten lists. Empty = rung 2 skipped.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open
# USD per 1M tokens on Baseten (GET /v1/models lists the price); costs are recorded at $0 while unset.
OPEN_WEIGHTS_PRICE_IN=1.25
OPEN_WEIGHTS_PRICE_OUT=4.25

# WhatsApp Cloud API. WHATSAPP_MODE=emulator runs the local emulator instead.
WHATSAPP_MODE=emulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Comma-separated E.164 numbers (digits only) allowed to use Dockhand.
REP_ALLOWLIST=

# HubSpot test portal Service Key (private apps can no longer be created as of 2026-10-26). Empty = in-memory fake.
HUBSPOT_TOKEN=

# Local services
GATEWAY_PORT=8787
PARTNER_PORTAL_PORT=5101
SUPPLIER_PORTAL_PORT=5102
FFMPEG_PATH=ffmpeg
# Runtime data (SQLite, artifacts, browser state). Default ./var; set a separate dir to run two dev processes side by side.
# DOCKHAND_VAR_DIR=
