                "text": "{\"buyerName\":null,\"city\":\"S\\u00e3o Paulo\",\"closeDate\":\"2027-01-29\",\"company\":\"Caf\\u00e9 Aurora Ltda.\",\"contactEmail\":\"julia@cafeaurora.example\",\"contactName\":\"J\\u00falia Prado\",\"contactPhone\":\"+55 11 99999-0142\",\"country\":\"Brazil\",\"estValue\":90000,\"intent\":\"register_deal\",\"inviteCode\":null,\"language\":\"pt\",\"missing\":[],\"notes\":\"6 lojas. Decis\\u00e3o dos s\\u00f3cios em janeiro.\",\"portalUrl\":null,\"product\":\"Tidewater Cloud Business\",\"referralPartner\":\"Rota Consultoria\",\"seats\":25,\"startDate\":null,\"summaryForRep\":\"Registering Caf\\u00e9 Aurora Ltda. deal referred by Rota Consultoria for 25 seats of Tidewater Cloud Business.\",\"tenant\":null,\"website\":\"cafeaurora.example\"}",
