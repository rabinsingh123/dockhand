{
  "name": "dockhand",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx apps/gateway/src/main.ts",
    "demo:check": "tsx apps/gateway/src/demo-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "preflight": "tsx apps/gateway/src/doctor.ts",
    "eval": "tsx packages/evals/src/cli.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "hubspot:seed": "tsx scripts/hubspot-seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
